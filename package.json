{
  "name": "@jankrum/style.css",
  "version": "0.2.0",
  "description": "Reusable stylesheet for semantic HTML",
  "style": "dist/style.css",
  "exports": {
    ".": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "cache": "curl -sL https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.css -o src/bulma.css && git rm --cached src/bulma.css 2>/dev/null || true",
    "build": "node build.js",
    "preview": "serve . -p 4000",
    "watch:css": "chokidar 'src/**/*.css' -c 'node build.js'",
    "watch:serve": "browser-sync start --server . --files 'dist/style.css,examples/**/*.html' --no-open",
    "dev": "npm run build && concurrently \"npm run watch:css\" \"npm run watch:serve\"",
    "test": "npm run build && node test/a11y.js",
    "lint": "stylelint 'src/**/*.css' && prettier --check 'build.js' 'test/a11y.js' 'examples/scripts/**/*.js' 'src/**/*.css' 'examples/**/*.html' '**/*.json'",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:js": "prettier --check 'build.js' 'test/a11y.js' 'examples/scripts/**/*.js'",
    "lint:html": "prettier --check 'examples/**/*.html'",
    "lint:json": "prettier --check '**/*.json'",
    "format": "prettier --write 'build.js' 'test/a11y.js' 'examples/scripts/**/*.js' 'src/**/*.css' 'examples/**/*.html' '**/*.json'",
    "typecheck": "tsc",
    "validate": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/pa11y": "^5.3.7",
    "browser-sync": "^3.0.0",
    "browserslist": "^4.24.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.0.0",
    "lightningcss": "^1.29.0",
    "pa11y": "^8.0.0",
    "prettier": "^3.8.3",
    "serve": "^14.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^6.0.3"
  }
}
